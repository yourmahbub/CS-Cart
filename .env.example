# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Everything here is read by the API process only and never reaches the browser.
# ---------------------------------------------------------------------------

# Port the API/server listens on.
PORT=4000

# Where the SQLite database file lives. Back this file up — it is your store.
DATABASE_PATH=./data/store.db

# --- Production only -------------------------------------------------------

# REQUIRED in production. Comma-separated list of origins allowed to make
# state-changing API calls. Set this to your real domain(s).
# ALLOWED_ORIGINS=https://yourstore.com,https://www.yourstore.com

# Number of reverse proxies in front of the app (nginx, Cloudflare, Fly, …).
# Needed so rate limiting sees the real client IP. 0 when directly exposed.
# TRUST_PROXY_HOPS=1

# --- First-run administrator ----------------------------------------------
# Set these BEFORE the first start to choose your own admin credentials.
# If omitted, a random password is generated and printed to the console once.
# ADMIN_EMAIL=you@yourstore.com
# ADMIN_PASSWORD=change-this-to-something-long
# ADMIN_NAME=Store Owner

# --- Card payments (optional) ----------------------------------------------
# Leave unset to run with cash-on-delivery and bank transfer only; the card
# option is then hidden at checkout.
# Get these from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
#
# Created when you add the webhook endpoint  https://yourstore.com/api/webhooks/stripe
# subscribed to the "checkout.session.completed" event.
# STRIPE_WEBHOOK_SECRET=whsec_...
